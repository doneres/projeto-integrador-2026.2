{
  "name": "@axis/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "API REST do AXIS (Fastify 5, Drizzle, Postgres)",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "node dist/server.js",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:seed": "tsx --env-file-if-exists=.env scripts/seed.ts",
    "db:generate": "drizzle-kit generate",
    "db:generate:custom": "drizzle-kit generate --custom"
  },
  "dependencies": {
    "@axis/contracts": "workspace:*",
    "@fastify/swagger": "^9.9.3",
    "@node-rs/argon2": "^2.2.2",
    "@scalar/fastify-api-reference": "^1.76.4",
    "drizzle-orm": "^0.45.4",
    "fastify": "~5.12.7",
    "fastify-type-provider-zod": "^7.0.0",
    "jose": "^6.2.14",
    "postgres": "^4.0.0",
    "uuid": "^14.0.3",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
