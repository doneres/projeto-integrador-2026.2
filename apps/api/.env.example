# Copie para .env (que não vai para o git). Só valores de desenvolvimento: nada aqui é secreto.
# Em produção os valores reais ficam no dashboard do Render.
NODE_ENV=development
PORT=3000

# Postgres do Docker Compose (pnpm db:up).
# DATABASE_URL atende as requisições; no Neon é a URL com pooler.
DATABASE_URL=postgres://axis:axis@localhost:5432/axis
# URL direta, sem pooler: é a que roda as migrations ao subir a API, o seed e o reset.
DATABASE_URL_UNPOOLED=postgres://axis:axis@localhost:5432/axis

# Segredo que assina os tokens de login (mínimo de 32 caracteres). Este é só de desenvolvimento;
# em produção gere um novo, por exemplo com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=desenvolvimento-local-troque-em-producao-0123456789

# Senhas das contas do seed, uma por perfil. Só o comando de seed as lê: a API sobe sem elas.
# Fora da máquina local o seed recusa estes valores; os de produção ficam no gerenciador de senhas.
SEED_PASSWORD_SELLER=axis-demo-2026
SEED_PASSWORD_COORDINATOR=axis-demo-2026
SEED_PASSWORD_DIRECTOR=axis-demo-2026
SEED_PASSWORD_ADMINISTRATOR=axis-demo-2026
