# Para usar a API real em desenvolvimento, copie para .env.development.local (não .env.local:
# o .env.development, que liga a API simulada, vale mais que o .env.local no Vite).

# URL base da API. Vazio = mesma origem (útil com o proxy do Vite).
VITE_API_URL=

# true = usa a API simulada (MSW) no lugar do backend real.
VITE_USE_MOCKS=false
